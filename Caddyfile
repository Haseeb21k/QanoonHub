# Caddyfile for QanoonHub reverse proxy
{
    # Global options
    admin off
    auto_https off
}

# Default site
:80 {
    # Logging
    log {
        output stdout
        format console
    }

    # Socket.io specific paths (must come before general API routes)
    handle /socket.io/* {
        reverse_proxy backend:9000 {
            # WebSocket support
            header_up Connection {http.request.header.Connection}
            header_up Upgrade {http.request.header.Upgrade}
            
            # Preserve original headers
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # API routes to backend
    handle /api/* {
        reverse_proxy backend:9000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Auth routes to backend
    handle /auth/* {
        reverse_proxy backend:9000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Uploads route to backend
    handle /uploads/* {
        reverse_proxy backend:9000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # All other routes to frontend
    handle /* {
        reverse_proxy frontend:80 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# HTTPS configuration (uncomment and modify when using a domain)
# https://yourdomain.com {
